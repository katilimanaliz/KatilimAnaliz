{
  "crons": [
    {
      "path": "/api/tefas-proxy?cron=1&parca=9",
      "schedule": "0 6 * * 1-5"
    },
    {
      "path": "/api/tefas-proxy?cron=1&parca=10",
      "schedule": "0 7 * * 1-5"
    },
    {
      "path": "/api/tefas-proxy?cron=1&parca=1",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/tefas-proxy?cron=1&parca=2",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/tefas-proxy?cron=1&parca=3",
      "schedule": "0 10 * * 1-5"
    },
    {
      "path": "/api/tefas-proxy?cron=1&parca=4",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/tefas-proxy?cron=1&parca=5",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/tefas-proxy?cron=1&parca=6",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/tefas-proxy?cron=1&parca=7",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/tefas-proxy?cron=1&parca=8",
      "schedule": "0 15 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}